# Included only in a newly generated workspace, before ament_auto_package().
option(LITE3_GPU_NDT_ENABLED "Explicitly enable the experimental CUDA backend" OFF)
if(LITE3_GPU_NDT_ENABLED)
  find_package(CUDA 11.0 REQUIRED)
endif()
find_package(PCL REQUIRED COMPONENTS common io filters kdtree registration)
if(NOT LITE3_NDT_OMP_HEADER_ONLY_DIR)
  find_package(ndt_omp REQUIRED)
  # Foxy's installed package exports a target, not ndt_omp_LIBRARIES.
  # Header discovery alone otherwise leaves the CPU baseline unlinked.
  if(TARGET ndt_omp::ndt_omp)
    set(LITE3_NDT_OMP_LIBRARIES ndt_omp::ndt_omp)
  elseif(TARGET ndt_omp)
    set(LITE3_NDT_OMP_LIBRARIES ndt_omp)
  elseif(ndt_omp_LIBRARIES)
    set(LITE3_NDT_OMP_LIBRARIES ${ndt_omp_LIBRARIES})
  else()
    message(FATAL_ERROR "ndt_omp has no exported link target/libraries; cannot build the production CPU baseline")
  endif()
else()
  set(ndt_omp_INCLUDE_DIRS "${LITE3_NDT_OMP_HEADER_ONLY_DIR}")
  set(LITE3_NDT_OMP_LIBRARIES "")
endif()
set(LITE3_GPU_NDT_INCLUDE "${CMAKE_CURRENT_LIST_DIR}/include")
set(LITE3_GPU_NDT_LIBRARIES ${LITE3_NDT_OMP_LIBRARIES})
if(LITE3_GPU_NDT_ENABLED)
  find_package(fast_gicp REQUIRED)
  find_library(LITE3_FAST_GICP_LIBRARY NAMES fast_gicp HINTS ${fast_gicp_LIBRARY_DIRS})
  find_library(LITE3_FAST_CUDA_LIBRARY NAMES fast_vgicp_cuda HINTS ${fast_gicp_LIBRARY_DIRS})
  if(NOT LITE3_FAST_GICP_LIBRARY OR NOT LITE3_FAST_CUDA_LIBRARY)
    message(FATAL_ERROR "NDT CUDA implementation library missing; build isolated fast_gicp with BUILD_VGICP_CUDA=ON")
  endif()
  list(APPEND LITE3_GPU_NDT_INCLUDE ${CUDA_INCLUDE_DIRS} ${fast_gicp_INCLUDE_DIRS})
  list(APPEND LITE3_GPU_NDT_LIBRARIES ${LITE3_FAST_GICP_LIBRARY} ${LITE3_FAST_CUDA_LIBRARY} ${CUDA_CUDART_LIBRARY})
  include(CheckCXXSourceCompiles)
  set(CMAKE_REQUIRED_INCLUDES ${LITE3_GPU_NDT_INCLUDE} ${PCL_INCLUDE_DIRS})
  set(CMAKE_REQUIRED_LIBRARIES ${LITE3_GPU_NDT_LIBRARIES} ${PCL_LIBRARIES})
  check_cxx_source_compiles("#include <fast_gicp/ndt/ndt_cuda.hpp>\n#include <pcl/point_types.h>\nint main(){fast_gicp::NDTCuda<pcl::PointXYZI,pcl::PointXYZI> n; n.setDistanceMode(fast_gicp::NDTDistanceMode::P2D);return 0;}" LITE3_NDT_CUDA_LINKS)
  if(NOT LITE3_NDT_CUDA_LINKS)
    message(FATAL_ERROR "NDT CUDA PointXYZI symbols/ABI do not link; header presence is insufficient")
  endif()
endif()
add_executable(lite3_ndt_benchmark "${CMAKE_CURRENT_LIST_DIR}/benchmark.cpp")
set(LITE3_GPU_NDT_TARGETS lite3_ndt_benchmark)
if(TARGET hdl_localization_composition)
  list(APPEND LITE3_GPU_NDT_TARGETS hdl_localization_composition)
endif()
foreach(target ${LITE3_GPU_NDT_TARGETS})
  target_include_directories(${target} PRIVATE ${LITE3_GPU_NDT_INCLUDE} ${PCL_INCLUDE_DIRS} ${ndt_omp_INCLUDE_DIRS})
  target_link_libraries(${target} ${LITE3_GPU_NDT_LIBRARIES} ${PCL_LIBRARIES})
  if(LITE3_GPU_NDT_ENABLED)
    target_compile_definitions(${target} PRIVATE LITE3_GPU_NDT_ENABLED)
  endif()
  if(LITE3_NDT_OMP_HEADER_ONLY_DIR)
    target_compile_definitions(${target} PRIVATE LITE3_NDT_OMP_HEADER_ONLY)
  endif()
endforeach()
install(TARGETS lite3_ndt_benchmark RUNTIME DESTINATION lib/${PROJECT_NAME})
